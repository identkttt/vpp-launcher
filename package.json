{
  "name": "vanilla-plus",
  "productName": "Vanilla++",
  "version": "1.1.1",
  "description": "Лаунчер Vanilla++ для ванильного Minecraft",
  "main": "src/main/main.js",
  "private": true,
  "author": "Vanilla++",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "setup": "electron src/setup/main.js",
    "icon": "java scripts/MakeIcon.java",
    "dist": "node scripts/dist.js",
    "dist:dir": "electron-builder --win --dir",
    "test:install": "node scripts/test-install.js"
  },
  "build": {
    "appId": "dev.vanilla.plus",
    "productName": "Vanilla++",
    "artifactName": "VanillaPlus-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/main/**/*",
      "src/renderer/**/*",
      "build/icon.png",
      "package.json",
      "launcher.config.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "dir"
      ]
    }
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  }
}
